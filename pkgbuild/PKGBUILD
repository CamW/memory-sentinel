pkgname=memory-sentinel
pkgver=0.1
pkgrel=2
pkgdesc="Memory Sentinel"
arch=('x86_64')
license=('MPL2')
source=('git+http://github.com/camw/memory-sentinel')
sha256sums=('SKIP')
makedepends=(cargo)
install=memory-sentinel.install

prepare() {
    echo "BUILD DIR: $srcdir/$pkgname"
    cd "$srcdir/$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --offline --target "$CARCH-unknown-linux-gnu"
}

build() {
    cd "$srcdir/$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-features
}

package() {
    cd "$srcdir/$pkgname"
    find target/release \
        -maxdepth 1 \
        -executable \
        -type f \
        -exec install -Dm0755 -t "$pkgdir/usr/bin/$pkgname/" {} +
    install -Dm0644 "config.yaml" "$pkgdir/etc/$pkgname/config.yaml"
    install -Dm0644 "$startdir/$pkgname.service" "$pkgdir/usr/lib/systemd/system/$pkgname.service"
}